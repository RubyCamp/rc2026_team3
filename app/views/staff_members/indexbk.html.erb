<% content_for :title, "スタッフ一覧" %>

<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">
    form
  </p>

  <h1 class="display-6 fw-bold">
    勤務依頼フォーム
  </h1><br>

  <%= form_with model: @work_request do |form| %>
    <%= form.search_field :q, value: params[:q] %>

  <% end %>

  <p class="page-lead text-body-secondary">
    会社名
  </p>
  <%= form_with url: tutorial_path, method: :get do |form| %>
    <%= form.search_field :q, value: params[:q] %>
  <% end %><br><br>

  <p class="page-lead text-body-secondary">
    日時
  </p>
  <%= form_with url: tutorial_path, method: :get do |form| %>
    <%= form.search_field :q, value: params[:q] %>
  <% end %><br><br>

  <p class="page-lead text-body-secondary">
    開始時間
  </p>
  <%= form_with url: tutorial_path, method: :get do |form| %>
    <%= form.search_field :q, value: params[:q] %>
  <% end %><br><br>

  <p class="page-lead text-body-secondary">
    終了時間
  </p>
  <%= form_with url: tutorial_path, method: :get do |form| %>
    <%= form.search_field :q, value: params[:q] %>
  <% end %><br><br>

  <p class="page-lead text-body-secondary">
    必要な人数
  </p>
  <%= form_with url: tutorial_path, method: :get do |form| %>
    <%= form.search_field :q, value: params[:q] %>
  <% end %><br><br>

  <%= form_with url: tutorial_path, method: :get do |form| %>
    <%= form.submit "確定" %>
  <% end %>


</div>
