 <% @work_request.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>

<%= form_with model: @work_request, class: "vstack gap-3" do |form| %>
      <!-- <div> -->
        <%#= form.label :buisines_id, "", class: "form-label" %>
        <%#= form.text_field :buisines_id, rows: 6, class: "form-control" %>
      <!-- </div> -->

      <div>
        <%= form.label :required_skill_id, "必要なスキル", class: "form-label" %>
        <%= form.collection_select :required_skill_id, @skills, :id, :name, class: "form-control" %>
      </div>

      <div>
        <%= form.label :title, "勤務依頼の名称", class: "form-label" %>
        <%= form.text_field :title, rows: 6, class: "form-control" %>
      </div>

      <div>
        <%= form.label :starts_at, "開始時刻", class: "form-label" %>
        <%= form.date_field :starts_at, rows: 6, class: "form-control" %>
      </div>

      <div>
        <%= form.label :ends_at, "終了時刻", class: "form-label" %>
        <%= form.date_field :ends_at, rows: 6, class: "form-control" %>
      </div>

      <div>
        <%= form.label :required_staff_count, "必要人数", class: "form-label" %>
        <%= form.number_field :required_staff_count, rows: 6, class: "form-control" %>
      </div>

      <div>
        <%= form.label :status, "依頼状態", class: "form-label" %>
        <%= form.select :status, WorkRequest.statuses.keys, class: "form-control" %>
      </div>

      <div>
        <%= form.label :notes, "備考", class: "form-label" %>
        <%= form.text_area :notes, rows: 6, class: "form-control" %>
      </div>

      <div><%= form.submit "保存する", class: "btn btn-primary" %></div>
    <% end %>
